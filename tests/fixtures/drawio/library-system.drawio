        </mxCell>
        <mxCell id="e1" value="borrows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;html=1;" edge="1" parent="1" source="member" target="book-ops">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="member" target="check">
