<mxfile host="app.diagrams.net" type="device">
  <diagram id="links" name="Links and data">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="Syllabus" link="https://example.com/syllabus" tooltip="Course outline for term 2" id="syl">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="40" width="140" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <object label="%subject% (%credits% credits)" placeholders="1" subject="Physics" credits="4" teacher="Ms. Rao" room="B-12" id="course">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="260" y="40" width="160" height="60" as="geometry" />
          </mxCell>
        </object>
        <UserObject label="Run me" link="javascript:alert(1)" id="bad">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="160" width="120" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Page 2" link="data:page/id,p2" id="pagelink">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="260" y="160" width="140" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="prerequisite" link="https://example.com/rules" id="e1">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="syl" target="course">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
