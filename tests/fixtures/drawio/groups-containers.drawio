        </mxCell>
        <mxCell id="fold" value="Folded" style="rounded=0;whiteSpace=wrap;html=1;container=1;" vertex="1" collapsed="1" parent="1">
          <mxGeometry x="100" y="320" width="120" height="40" as="geometry">
            <mxRectangle x="100" y="320" width="240" height="160" as="alternateBounds" />
