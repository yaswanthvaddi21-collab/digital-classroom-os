        </mxCell>
        <mxCell id="box" value="Toolbox" style="rounded=0;whiteSpace=wrap;html=1;container=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tool" value="Ruler" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="box">
