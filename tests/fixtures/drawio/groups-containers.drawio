        </mxCell>
        <mxCell id="e1" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="g1" target="box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=block;html=1;" edge="1" parent="g1" source="a" target="b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
