<mxfile host="app.diagrams.net" type="device">
  <diagram id="groups" name="Groups">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="g1" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="100" y="80" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="a" value="Read" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="g1">
          <mxGeometry width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="" style="group" vertex="1" connectable="0" parent="g1">
          <mxGeometry x="160" y="80" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b" value="Write" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="g2">
