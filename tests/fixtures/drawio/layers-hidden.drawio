<mxfile host="app.diagrams.net" type="device">
  <diagram id="layers" name="Quiz">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" value="Questions" parent="0" />
        <mxCell id="ans" value="Answers" parent="0" visible="0" />
        <mxCell id="notes" value="Teacher notes" style="locked=1;" parent="0" />
        <mxCell id="q1" value="Q1: What is 7 x 8?" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hint" value="Hint: think of 7 x 7" style="shape=note;whiteSpace=wrap;html=1;" vertex="1" parent="1" visible="0">
          <mxGeometry x="240" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hg" value="" style="group" vertex="1" connectable="0" parent="1" visible="0">
          <mxGeometry x="40" y="300" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hgchild" value="Draft" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="hg">
          <mxGeometry width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="56" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="ans">
          <mxGeometry x="40" y="160" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Ask pairs first" style="text;html=1;" vertex="1" parent="notes">
          <mxGeometry x="240" y="160" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="eh" value="secret link" style="endArrow=block;html=1;" edge="1" parent="1" source="q1" target="n1" visible="0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el" value="" style="endArrow=block;html=1;" edge="1" parent="ans" source="q1" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea" value="" style="endArrow=block;html=1;" edge="1" parent="ans" source="q1" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
