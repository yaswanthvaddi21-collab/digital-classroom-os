<mxfile host="app.diagrams.net" type="device">
  <diagram id="conn" name="Connectors">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a" value="A" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b" value="B" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c" value="C" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="frame" value="" style="rounded=0;whiteSpace=wrap;html=1;container=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="F1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="frame">
          <mxGeometry x="20" y="20" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="F2" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="frame">
          <mxGeometry x="300" y="140" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bend" value="via" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a" target="b">
          <mxGeometry x="-0.5" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="250" y="70" />
              <mxPoint x="250" y="200" />
              <mxPoint x="430" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="inner" value="" style="edgeStyle=none;html=1;endArrow=open;" edge="1" parent="frame" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="40" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="off" value="off the line" style="endArrow=block;html=1;exitX=0.5;exitY=1;exitDx=10;exitDy=0;" edge="1" parent="1" source="c" target="b">
          <mxGeometry x="0.2" y="15" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="two" value="first" style="endArrow=block;html=1;locked=1;opacity=50;" edge="1" parent="1" source="a" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="two-l" value="second" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="two">
          <mxGeometry x="0.6" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="c" target="a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-l" value="only label" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="lbl">
          <mxGeometry x="-0.8" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="toedge" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="b" target="two">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loose" value="" style="endArrow=block;html=1;" edge="1" parent="1" source="b">
          <mxGeometry relative="1" as="geometry">
