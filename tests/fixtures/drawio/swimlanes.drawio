<mxfile host="app.diagrams.net" type="device">
  <diagram id="lanes" name="Admissions">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pool" value="Admissions" style="swimlane;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=0;startSize=20;horizontalStack=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="500" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lane1" value="Applicant" style="swimlane;startSize=20;horizontal=0;html=1;fillColor=#dae8fc;" vertex="1" parent="pool">
          <mxGeometry x="20" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="Office" style="swimlane;startSize=20;horizontal=0;html=1;" vertex="1" parent="pool">
          <mxGeometry x="20" y="120" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="apply" value="Apply" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane1">
          <mxGeometry x="40" y="30" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="review" value="Review" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lane2">
          <mxGeometry x="60" y="20" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flow" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="pool" source="apply" target="review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="top" value="Library desk" style="swimlane;startSize=24;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lend" value="Lend book" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="top">
          <mxGeometry x="40" y="60" width="120" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
